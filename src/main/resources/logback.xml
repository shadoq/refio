<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- File appender — keeps console clean for TUI -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${refio.log.dir:-.refio}/refio-cli.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger — file only, no console -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>

    <!-- Disable Exposed ORM SQL query logging -->
    <logger name="Exposed" level="WARN"/>
    <logger name="org.jetbrains.exposed.sql.statements" level="WARN"/>
    <logger name="org.jetbrains.exposed.sql.transactions" level="WARN"/>

    <!-- Keep plugin debug logging enabled -->
    <logger name="pl.jclab" level="DEBUG"/>
</configuration>
