<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger - set to WARN to reduce noise during tests -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Set specific loggers to ERROR to minimize test output -->
    <logger name="io.ktor" level="ERROR"/>
    <logger name="io.netty" level="ERROR"/>
    <logger name="org.jetbrains" level="ERROR"/>

    <!-- You can enable DEBUG for specific packages during debugging -->
    <!-- <logger name="pl.jclab" level="DEBUG"/> -->
</configuration>
