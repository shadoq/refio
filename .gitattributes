# The e2e case catalog and everything generated from it must stay LF in the working
# tree, not just in the index: the generator writes LF and compares byte-for-byte
# against the file on disk, so a CRLF checkout would report permanent false drift.
test_data/e2e_catalog/**/*.json text eol=lf
test_data/e2e_catalog/**/*.md   text eol=lf
test_data/e2e/*.json            text eol=lf
test_data/e2e/prompts/*.md      text eol=lf

# Shell scripts must keep LF so they stay runnable from Git Bash / WSL / CI.
*.sh text eol=lf
