{
  "openapi": "3.0.3",
  "info": {
    "title": "UserDir API",
    "version": "2.3.0",
    "description": "The user directory service of the demo environment."
  },
  "paths": {
    "/api/v2/users": {
      "get": {
        "summary": "List users",
        "description": "Returns every user, optionally filtered by department.",
        "parameters": [
          {
            "name": "dept",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Department filter (eng, ops)."
          }
        ],
        "responses": {
          "200": {
            "description": "The user list.",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": { "description": "The service is up." }
        }
      }
    }
  }
}
