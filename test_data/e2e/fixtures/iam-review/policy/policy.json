{
  "Version": "2026-10-01",
  "Statement": [
    {
      "Sid": "legacy-full-backup",
      "Effect": "Allow",
      "Principal": "svc-backup",
      "Action": [
        "*:*"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "legacy-full-deploy",
      "Effect": "Allow",
      "Principal": "svc-deploy",
      "Action": [
        "*:*"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "staff-files-and-secrets",
      "Effect": "Allow",
      "Principal": "group:staff",
      "Action": [
        "files:*",
        "secrets:Read"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "oncall-rotates-secrets",
      "Effect": "Allow",
      "Principal": "group:oncall",
      "Action": [
        "secrets:Rotate"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "dba-all",
      "Effect": "Allow",
      "Principal": "group:dba",
      "Action": [
        "db:*"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "analysts-all",
      "Effect": "Allow",
      "Principal": "group:analysts",
      "Action": [
        "db:*"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "platform-all",
      "Effect": "Allow",
      "Principal": "group:platform",
      "Action": [
        "iam:*",
        "deploy:*"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "report-export-temporary",
      "Effect": "Allow",
      "Principal": "svc-report",
      "Action": [
        "db:*",
        "files:*"
      ],
      "Resource": [
        "*"
      ]
    }
  ]
}
