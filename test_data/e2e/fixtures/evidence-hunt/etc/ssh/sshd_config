# /etc/ssh/sshd_config - the sshd server configuration
Port 22
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ed25519_key
SyslogFacility AUTH
LogLevel INFO
LoginGraceTime 120
PermitRootLogin no
MaxAuthTries 4
X11Forwarding no
PrintMotd no
Subsystem sftp /usr/lib/openssh/sftp-server
