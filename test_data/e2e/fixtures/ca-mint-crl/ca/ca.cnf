[ ca ]
default_ca = CA_default

[ CA_default ]
dir               = .
database          = $dir/ca/index.txt
crlnumber         = $dir/ca/crlnumber
certificate       = $dir/pki/ca.crt
private_key       = $dir/pki/ca.key
default_md        = sha256
default_crl_days  = 3600
policy            = policy_any

[ policy_any ]
commonName = supplied
