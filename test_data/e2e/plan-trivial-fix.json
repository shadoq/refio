{
  "id": "plan-trivial-fix",
  "mode": "PLAN",
  "description": "Plan a one-line typo fix without overplanning: at most three steps, aimed at the one real file.",
  "category": "planning",
  "max_iterations": 30,
  "fixture": "fixtures/plan-trivial-fix",
  "prompt_file": "prompts/plan-trivial-fix.md",
  "assert": {
    "plan": {
      "min_steps": 1,
      "max_steps": 3,
      "covers": [
        {
          "label": "app/validate.py",
          "regex": "validate\\.py"
        }
      ],
      "paths_exist": true,
      "new_paths": [
        "^tests/"
      ]
    },
    "no_context_overflow": true
  },
  "judge": {
    "criteria": [
      "The plan has at most three steps: fix the message in app/validate.py and run the existing tests."
    ]
  }
}
