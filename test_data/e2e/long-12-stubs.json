{
  "id": "long-12-stubs",
  "mode": "AGENT",
  "description": "Implement twelve helper stubs as a long task: after every round the harness runs node run-tests.js and starts another round until all twelve tests pass; the score is how many of the twelve pass when the run ends.",
  "category": "multi-file",
  "max_iterations": 200,
  "fixture": "fixtures/long-12-stubs",
  "prompt_file": "prompts/long-12-stubs.md",
  "until": "node run-tests.js",
  "max_rounds": 4,
  "config": [
    "long_task.max_minutes=30"
  ],
  "score": {
    "cmd": "node run-tests.js",
    "regex": "SUMMARY passed ([0-9]+/[0-9]+)"
  },
  "assert": {
    "needles_in_file": [
      {
