        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/clamp.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/flatten.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/groupBy.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/isValidIPv4.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/median.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/parseDuration.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/rle.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/romanToInt.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/slugify.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/wordFreq.js",
        "text": "not implemented",
        "absent": true
      }
    ],
    "file_unchanged": [
      "run-tests.js",
      "package.json",
      "tests/camelCase.test.js",
      "tests/chunk.test.js",
      "tests/clamp.test.js",
      "tests/flatten.test.js",
      "tests/groupBy.test.js",
      "tests/isValidIPv4.test.js",
      "tests/median.test.js",
      "tests/parseDuration.test.js",
      "tests/rle.test.js",
      "tests/romanToInt.test.js",
      "tests/slugify.test.js",
      "tests/wordFreq.test.js"
    ],
    "build_cmd": "node run-tests.js",
    "no_context_overflow": true
  },
  "judge": {
    "criteria": [
      "All twelve helpers in src/ are implemented so node run-tests.js prints SUMMARY passed 12/12, with nothing under tests/, run-tests.js or package.json changed."
    ]
  }
}
