# Main sudoers policy for web03.
# Managed by hand since 2019; do not reformat. Drop-ins live in sudoers.d/.

Defaults env_reset
Defaults mail_badpass
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

root ALL=(ALL:ALL) ALL
%wheel ALL=(ALL:ALL) ALL
ops ALL=(root) NOPASSWD: /usr/bin/systemctl reload nginx
