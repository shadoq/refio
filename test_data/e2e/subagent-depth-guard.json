{
  "id": "subagent-depth-guard",
  "mode": "AGENT",
  "max_iterations": 30,
  "fixture": "fixtures/subagent-depth",
  "prompt_file": "prompts/subagent-depth.md",
  "assert": {
    "needle_in_output": { "regex": "fox|dog|note" },
    "no_context_overflow": true
  },
  "judge": {
    "criteria": ["Did the run finish with a one-sentence summary rather than hanging on unbounded subagent delegation (max depth 3)?"]
  }
}
