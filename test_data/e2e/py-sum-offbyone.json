{
  "id": "py-sum-offbyone",
  "mode": "AGENT",
  "description": "Fix the off-by-one in total(n) in main.py so it sums 1..n inclusive and the asserts pass.",
  "category": "bugfix",
  "max_iterations": 25,
  "fixture": "fixtures/py-sum",
  "prompt_file": "prompts/py-sum-offbyone.md",
  "assert": {
    "tool_order": ["read_file", "advance_code_editing"],
    "needles_in_file": [
      { "path": "src/main.py", "regex": "n[[:space:]]*\\+[[:space:]]*1" },
      { "path": "src/main.py", "regex": "total\\(5\\)[[:space:]]*==[[:space:]]*15" }
    ],
    "build_cmd": "python3 src/main.py",
    "no_context_overflow": true
  },
  "judge": { "criteria": ["total sums 1..n inclusive; the asserts are unchanged; program prints OK."] }
}
