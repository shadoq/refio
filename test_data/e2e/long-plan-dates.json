{
  "id": "long-plan-dates",
  "mode": "AGENT",
  "description": "Implement a five-function date library as a long task with a tasks-tool plan: parseDate comes before the functions built on it, steps are marked completed, the failing-test count never grows between rounds, and all five tests pass within three rounds.",
  "category": "planning",
  "max_iterations": 200,
  "fixture": "fixtures/long-plan-dates",
  "prompt_file": "prompts/long-plan-dates.md",
  "until": "node run-tests.js",
  "max_rounds": 5,
  "config": [
    "long_task.max_minutes=30"
  ],
  "score": {
    "cmd": "node run-tests.js",
    "regex": "SUMMARY passed ([0-9]+/[0-9]+)"
  },
  "assert": {
    "plan": {
      "source": "tasks",
      "min_steps": 4,
      "max_steps": 15,
      "completed": {
        "min": 4
      },
      "order": [
        {
          "before": "parseDate",
          "after": "addDays|diffDays|isWeekend",
          "before_label": "parseDate",
          "after_label": "what is built on parseDate"
        }
      ]
    },
    "rounds": {
      "max": 3,
      "errors_non_increasing": true,
      "progress_file": true
    },
    "needles_in_file": [
      {
        "path": "src/parseDate.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/formatDate.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/addDays.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/diffDays.js",
        "text": "not implemented",
        "absent": true
      },
      {
        "path": "src/isWeekend.js",
        "text": "not implemented",
        "absent": true
      }
    ],
    "file_unchanged": [
      "run-tests.js",
      "package.json",
      "tests/parseDate.test.js",
      "tests/formatDate.test.js",
      "tests/addDays.test.js",
      "tests/diffDays.test.js",
      "tests/isWeekend.test.js"
    ],
    "build_cmd": "node run-tests.js",
    "no_context_overflow": true
  },
  "judge": {
    "criteria": [
      "All five functions in src/ are implemented so node run-tests.js prints SUMMARY passed 5/5, the plan was kept in the tasks tool with its steps completed, and nothing under tests/, run-tests.js or package.json changed."
    ]
  }
}
